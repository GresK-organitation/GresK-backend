# ─────────────────────────────────────────────────────────────
# Gresk Backend — Variables de entorno
# Copia este archivo como .env y rellena los valores:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# Seguridad
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ── Email Intelligence Engine ────────────────────────────────
# Capa 3 del pipeline (Claude API)
ANTHROPIC_API_KEY=
# Capa 2 del pipeline (modelo local, opcional en dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OAuth de Gmail (Google Cloud Console → credenciales OAuth 2.0)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
APP_BASE_URL=http://localhost:8080
# Topic Pub/Sub para notificaciones push (projects/<proyecto>/topics/<topic>)
GMAIL_PUBSUB_TOPIC=
# Token compartido que valida los POST del webhook
GMAIL_PUBSUB_TOKEN=

# Cifrado AES-256-GCM de los tokens OAuth — generar con: openssl rand -base64 32
EMAIL_TOKEN_ENCRYPTION_KEY=

# SMTP para envío de respuestas aprobadas
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
